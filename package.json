{
  "name": "lightread",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight document reader & editor built with Tauri 2, React, TypeScript, shadcn/ui, and Tailwind CSS.",
  "author": "Kumix Labs <hai@kumix.io>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:all": "rm -rf bun.lock dist node_modules src-tauri/Cargo.lock src-tauri/gen src-tauri/target",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "format:check": "biome check",
    "types:check": "tsc --noEmit",
    "tauri": "tauri",
    "bump": "bumpp"
  },
  "homepage": "https://github.com/kumixlabs/lightread",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumixlabs/lightread.git"
  },
  "bugs": {
    "url": "https://github.com/kumixlabs/lightread/issues"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@kumix/ui": "^0.3.9",
    "@kumix/utils": "^0.2.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@kumix/biome-config": "^0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "bump": "^0.2.5",
    "shadcn": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}