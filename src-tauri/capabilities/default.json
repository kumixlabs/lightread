{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LightRead default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-is-fullscreen",
    "dialog:allow-open",
    "dialog:allow-save",
    "log:default",
    "opener:allow-open-path",
    "opener:default"
  ]
}